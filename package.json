{
  "version": "1.0.0",
  "name": "phoenix-nextjs",
  "description": "Phoenix website built with Next.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:prod": "cross-env PORT=3001 next build",
    "build:3000": "cross-env PORT=3000 next build",
    "build:8080": "cross-env PORT=8080 next build",
    "start": "next start -p 3001",
    "start:3000": "next start -p 3000",
    "start:8080": "next start -p 8080",
    "preview": "npx serve@latest out -p 3001",
    "preview:3000": "npx serve@latest out -p 3000",
    "preview:8080": "npx serve@latest out -p 8080",
    "build-and-start": "npm run build && npm run start",
    "build-and-start:3000": "npm run build:3000 && npm run start:3000",
    "build-and-start:8080": "npm run build:8080 && npm run start:8080",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/three": "^0.181.0",
    "clsx": "2.1.1",
    "framer-motion": "^12.23.24",
    "i18next": "^25.6.0",
    "lottie-react": "^2.4.1",
    "next": "^15.5.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.8.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "globals": "15.12.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.16",
    "typescript": "5.9.3"
  }
}
